# Example environment variables for the FastAPI server (DataStax Astra + Groq)
# Copy to `.env` in `/server` and fill values before running.

# Groq (LLM) API key
GROQ_API_KEY=gsk_your_key_here

# DataStax Astra DB (Document API / REST)
# Create an Application Token in Astra (with Data API access) and set the REST endpoint and keyspace.
ASTRA_DB_TOKEN=your_astra_application_token_here
ASTRA_DB_API_ENDPOINT=https://<db-id>-<region>.apps.astra.datastax.com
ASTRA_DB_KEYSPACE=your_keyspace_here

# CORS: comma-separated origins (Next.js dev server default shown)
ALLOWED_ORIGINS=http://localhost:3000
